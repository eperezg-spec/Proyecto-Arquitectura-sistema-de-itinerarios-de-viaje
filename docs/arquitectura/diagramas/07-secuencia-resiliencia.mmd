%% Resiliencia frente a API Colombia: caché, timeout, retry, circuit breaker, fallback
sequenceDiagram
  autonumber
  participant UC as AirportService
  participant C as CachedAirportProvider
  participant R as Redis
  participant CB as CircuitBreaker
  participant A as ApiColombiaAdapter
  participant API as API Colombia

  UC->>C: get_by_id(id)
  C->>R: GET airport:fresh:id
  alt HIT (copia fresca, TTL 1 h)
    R-->>C: JSON
    C-->>UC: Airport
  else MISS
    C->>CB: call(fetch)
    alt circuito CLOSED / HALF_OPEN
      CB->>A: fetch
      loop hasta 3 intentos · backoff exponencial + jitter
        A->>API: GET /api/v1/Airport/id (timeout 3 s)
        API--xA: timeout / 5xx
      end
      A-->>CB: AirportProviderUnavailable
      CB->>CB: fallos++ ≥5 → OPEN · métrica circuit_breaker_state=2
    else circuito OPEN
      CB-->>C: CircuitOpenError inmediato (sin llamar a la API)
    end
    C->>R: GET airport:stale:id
    alt existe copia stale
      R-->>C: JSON
      C-->>UC: Airport (modo degradado, HTTP 200)
    else sin copia
      C-->>UC: AirportProviderUnavailable → HTTP 503 + Retry-After
    end
  end
  Note over CB: Pasado reset_timeout (30 s) → HALF_OPEN: una llamada de prueba.<br/>Éxito → CLOSED · Fallo → OPEN
