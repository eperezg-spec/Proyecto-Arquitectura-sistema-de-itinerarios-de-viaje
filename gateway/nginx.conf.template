# API GATEWAY (nginx): único punto de entrada del sistema -> http://localhost:8080
#  - Ruteo hacia los microservicios internos
#  - Rate limiting básico (10 peticiones/segundo por IP, ráfagas de 20)
#  - Propaga el header Authorization (JWT) y un X-Request-ID
#  - Sirve el frontend estático
#  - NO tiene lógica de negocio

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_status 429;

server {
    listen 80;

    # DNS interno de Docker. Usar variables en proxy_pass obliga a nginx a
    # resolver el nombre en cada petición: si un servicio se reinicia y cambia
    # de IP, el gateway lo sigue encontrando (sin esto daría 502).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $auth_service      http://auth-service:8000;
    set $airport_service   http://airport-service:8000;
    set $itinerary_service http://itinerary-service:8000;

    # nginx pasa "Authorization" automáticamente; añadimos info útil para trazabilidad
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-ID $request_id;

    # Frontend
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /auth/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass $auth_service;
    }

    location /api/v1/airports {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass $airport_service;
    }

    location /api/v1/itineraries {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass $itinerary_service;
    }
}
